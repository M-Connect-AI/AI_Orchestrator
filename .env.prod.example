# Copy: cp .env.example .env
# Không commit file .env

JWT_SECRET=thay-bang-chuoi-dai-ngau-nhien

# GreenNode MaaS
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.7-plus
EMBEDDING_MODEL=baai/bge-m3
QDRANT_POLICY_COLLECTION=policy_chunks

# Jira via Atlassian Rovo MCP (đọc và tạo task có xác nhận)
JIRA_MCP_URL=https://mcp.atlassian.com/v2/mcp?tools=all
JIRA_MCP_AUTH_TYPE=bearer
JIRA_MCP_EMAIL=
JIRA_MCP_API_TOKEN=
JIRA_MCP_API_KEY=
JIRA_MCP_CLOUD_ID=
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_MCP_ASSIGNEE_MODE=actor-email
JIRA_MCP_MAX_ISSUES=200
JIRA_MCP_STALE_DAYS=14

# Caddy / domain
# Chưa có domain: để http://:80 rồi vào http://<IP-public>
# Có domain trỏ A record về IP VM: copilot.example.com (Caddy tự xin HTTPS)
SITE_ADDRESS=http://:80
ACME_EMAIL=you@example.com

# Outlook (tuỳ chọn). Redirect phải khớp Azure App Registration.
# WEB_ORIGIN = URL user mở trên trình duyệt (qua Caddy).
WEB_ORIGIN=http://localhost
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost/api/hr/outlook/callback
