# Shared
JWT_SECRET=msb-hackathon-dev-secret-change-me
MONGO_URI=mongodb://localhost:27017/msb_hr

# HR Mock
HR_PORT=3002
HR_MONGO_URI=mongodb://localhost:27017/msb_hr

# Agent
AGENT_PORT=3001
AGENT_MONGO_URI=mongodb://localhost:27017/msb_hr_agent
HR_MOCK_BASE_URL=http://127.0.0.1:3002

# OpenAI-compatible LLM (GreenNode MaaS or local fallback)
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.7-plus
# GLM-5.3 luôn thinking: low | high | max (mặc định low). Qwen bỏ qua.
# LLM_REASONING_EFFORT=low
EMBEDDING_MODEL=baai/bge-m3

# Jira via Atlassian Rovo MCP (đọc và tạo task có xác nhận)
JIRA_MCP_URL=https://mcp.atlassian.com/v2/mcp?tools=all
# basic = personal API token; bearer = service account API key
JIRA_MCP_AUTH_TYPE=basic
JIRA_MCP_EMAIL=
JIRA_MCP_API_TOKEN=
JIRA_MCP_API_KEY=
# Có thể để trống để MCP tự tìm site đầu tiên được cấp quyền
JIRA_MCP_CLOUD_ID=
JIRA_BASE_URL=https://your-domain.atlassian.net
# actor-email: map email M-Connect sang assignee Jira; current-user: credential riêng từng user
JIRA_MCP_ASSIGNEE_MODE=actor-email
JIRA_MCP_MAX_ISSUES=200
JIRA_MCP_STALE_DAYS=14

# Policy RAG (Qdrant) — docker compose up -d  rồi  pnpm policy:ingest
QDRANT_URL=http://127.0.0.1:6333
QDRANT_POLICY_COLLECTION=policy_chunks

# Web
VITE_AGENT_API_URL=http://localhost:3001
VITE_HR_API_URL=http://localhost:3002
WEB_ORIGIN=http://localhost:5173

# Outlook / Microsoft Graph (kết nối riêng sau login HR)
# Azure App registration → Redirect URI (Web): http://localhost:3002/outlook/callback
# API permissions (Delegated): User.Read, Calendars.ReadWrite, Mail.ReadWrite, Mail.Send
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3002/outlook/callback
# MS_GRAPH_SCOPES=openid profile email offline_access User.Read Calendars.ReadWrite Mail.ReadWrite Mail.Send
# OUTLOOK_TOKEN_SECRET=optional-separate-secret
